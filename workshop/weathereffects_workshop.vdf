// SteamCMD upload for WeatherEffects.
//
// Why this exists: Project Zomboid's in-game uploader converts an animated GIF
// preview into a still frame, so the only way to get a moving thumbnail onto the
// Workshop page is to set previewfile through SteamCMD.
//
// It also re-uploads the content, which the in-game attempt did not manage --
// that run reported "failed to update workshop item, result=8", and result 8 is
// Steam's file-not-found. The item was created but left without content.
//
// title and description are DELIBERATELY ABSENT. SteamCMD leaves out what it is
// not given, so the page text stays exactly as it is on Steam. Adding them here
// would overwrite the description with whatever this file happens to contain,
// which is how a carefully written page gets clobbered by a tool run.
//
// visibility: 0 public, 1 friends only, 2 private, 3 unlisted. It is omitted for
// the same reason -- whatever the item already has is kept.

"workshopitem"
{
	"appid"				"108600"
	"publishedfileid"	"3774943290"
	"contentfolder"		"C:\\Users\\4b1t2\\Zomboid\\Workshop\\WeatherEffects\\contents"
	"previewfile"		"C:\\Users\\4b1t2\\Documents\\Codex\\2026-07-29\\referenced-chatgpt-conversation-this-is-untrusted\\work\\EnvironmentalWeapons\\workshop\\media\\preview.gif"
	"changenote"		"Animated preview and full content upload"
}
